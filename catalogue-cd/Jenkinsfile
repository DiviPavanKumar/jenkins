// Roboshop - Catalogue Deployment Pipeline

pipeline {
    agent { label 'AGENT-1' }

    environment { 
        REGION    = "us-east-1"
        ACC_ID    = "069233348386"
        PROJECT   = "roboshop"
        COMPONENT = "catalogue"
    }

    options {
        timeout(time: 30, unit: 'MINUTES') 
        disableConcurrentBuilds()
    }

    parameters {
        string(name: 'appVersion', description: 'Image version of the application')
        choice(name: 'deploy_to', choices: ['dev', 'qa', 'prod'], description: 'Target Environment')
    }

    stages {
        stage('Deploy to Kubernetes') {
            steps {
                script {
                    withAWS(credentials: 'aws-config', region: "${REGION}") {
                        sh """
                            echo "Deploying ${COMPONENT}:${params.appVersion} to ${params.deploy_to} cluster"

                            # Update kubeconfig for target cluster
                            aws eks update-kubeconfig --region ${REGION} --name "${PROJECT}-${params.deploy_to}"

                            # Check cluster connectivity
                            kubectl get nodes

                            # Create namespace if not exists
                            kubectl apply -f 01-namespace.yaml

                            # Replace image tag in Helm values file
                            sed -i "s/IMAGE_VERSION/${params.appVersion}/g" values-${params.deploy_to}.yaml

                            # Deploy using Helm
                            helm upgrade --install ${COMPONENT} -f values-${params.deploy_to}.yaml -n ${PROJECT} .
                        """
                    }
                }
            }
        }
    }

    post { 
        always { 
            echo "Cleaning workspace..."
            deleteDir()
        }
        success { 
            echo "✅ Deployment of ${COMPONENT}:${params.appVersion} to ${params.deploy_to} was successful!"
        }
        failure { 
            echo "❌ Deployment failed for ${COMPONENT}:${params.appVersion} in ${params.deploy_to}"
        }
    }
}
