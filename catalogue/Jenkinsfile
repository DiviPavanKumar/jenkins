pipeline {
    agent { label 'AGENT-1' }

    environment { 
        ACCOUNT_ID   = "069233348386"
        REGION       = "us-east-1"
        PROJECT      = "roboshop"
        SERVICE_NAME = "catalogue"
        PLATFORM     = "amazonaws.com"
    }

    stages {
        stage('Read Package Version') {
            steps {
                script {
                    def packageJson = readJSON file: 'catalogue/package.json'
                    env.VERSION = packageJson.version   // set globally
                    echo "Package version: ${env.VERSION}"
                }
            }
        }

        stage('Image Build and Push') {
            steps {
                script {
                    sh """
                    aws ecr get-login-password --region ${env.REGION} | docker login --username AWS --password-stdin ${env.ACCOUNT_ID}.dkr.ecr.${env.REGION}.${env.PLATFORM}

                    docker build -t ${env.PROJECT}/${env.SERVICE_NAME}:${env.VERSION} ${env.SERVICE_NAME}/
                    docker tag ${env.PROJECT}/${env.SERVICE_NAME}:${env.VERSION} ${env.ACCOUNT_ID}.dkr.ecr.${env.REGION}.${env.PLATFORM}/${env.PROJECT}/${env.SERVICE_NAME}:${env.VERSION}
                    docker push ${env.ACCOUNT_ID}.dkr.ecr.${env.REGION}.${env.PLATFORM}/${env.PROJECT}/${env.SERVICE_NAME}:${env.VERSION}
                    """
                }
            }
        }
    }
}
