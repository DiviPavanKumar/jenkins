pipeline {
    // Pre build stage
    agent { label 'AGENT-1' }

    environment { 
        VERSION = ''
    }

    // Build stages
    stages {
        stage('Read Package Version') {
            steps {
                script {
                    def packageJson = readJSON file: 'catalogue/package.json'
                    env.VERSION = packageJson.version
                    echo "Package version: ${env.VERSION}"
                }
            }
        }
    }
}
