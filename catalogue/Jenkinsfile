pipeline {
    agent { label 'AGENT-1' }

    environment { 
        VERSION = ""   // define here, will update later
    }

    stages {
        stage('Read Package Version') {
            steps {
                script {
                    // Read package.json file
                    def packageJson = readJSON file: 'catalogue/package.json'

                    // Assign version into env variable
                    env.VERSION = packageJson.version
                }
            }
        }

        stage('Print Version') {
            steps {
                echo "Package version from package.json = ${env.VERSION}"
            }
        }
    }
}
