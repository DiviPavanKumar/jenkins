pipeline {
    agent { label 'AGENT-1' }

    environment { 
        VERSION = ''
    }

    stages {
        stage('Read Package Version') {
            steps {
                script {
                    def packageJson = readJSON file: 'catalogue/package.json'
                    echo "Full package.json content: ${packageJson}"
                    echo "Version field: ${packageJson.version}"

                    env.VERSION = packageJson.version
                    echo "Package version: ${env.VERSION}"
                }
            }
        }
    }
}
