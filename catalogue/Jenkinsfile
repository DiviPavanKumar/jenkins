pipeline {
    agent { label 'AGENT-1' }

    environment { 
        VERSION = ''
    }

    stages {
        stage('Read Package Version') {
            steps {
                script {
                    // Debug: show files
                    sh 'ls -R'

                    def packageJson = readJSON file: 'catalogue/package.json'  // adjust path if needed
                    env.VERSION = packageJson.version
                    echo "Package version: ${env.VERSION}"
                }
            }
        }
    }
}
