pipeline {
    agent { label 'AGENT-1' }

    environment { 
        ACCOUNT-ID = "069233348386"
        REGION = "us-east-1"
        PROJECT = "roboshop"
        SERVICE = "catalogue"
        VERSION = ""   // define here, will update later
    }


    stages {
        stage('Read Package Version') {
            steps {
                script {
                    def packageJson = readJSON file: 'catalogue/package.json'
                    def version = packageJson.version
                    echo "Package version: ${version}"
                }
            }
        }
        stage('Image Build and Push') {
            steps {
                script {
                    sh """
                    aws ecr get-login-password --region ${region} | docker login --username AWS --password-stdin ${account-id}.dkr.ecr.${region}.amazonaws.com
                    docker build -t ${project}/${service} catalogue/
                    docker tag ${project}/${service}:${version} ${account-id}.dkr.ecr.${region}.amazonaws.com/${project}/${service}:${version}
                    docker push ${account-id}.dkr.ecr.${region}.amazonaws.com/${project}/${service}:${version}
                    """
                }
            }
        }
    }
}
