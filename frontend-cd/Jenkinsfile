pipeline {
    agent { label 'AGENT-1' }

    environment { 
        ACCOUNT_ID   = "069233348386"
        REGION       = "us-east-1"
        PROJECT      = "roboshop"
        SERVICE_NAME = "frontend"
        PLATFORM     = "amazonaws.com"
    }

    options {
        timeout(time: 30, unit: 'MINUTES') 
        disableConcurrentBuilds()
    }

    parameters {
        string(name: 'appVersion', description: 'Image version of the application', defaultValue: 'latest')
        choice(name: 'deploy_to', choices: ['dev', 'qa', 'prod'], description: 'Target Environment')
    }

    stages {
        stage('Deploy to Kubernetes') {
            steps {
                script {
                    if (!params.appVersion) {
                        error "appVersion parameter is required!"
                    }
                    withAWS(credentials: 'aws-config', region: "${REGION}") {
                        sh """
                            echo "Deploying ${SERVICE_NAME}:${params.appVersion} to ${params.deploy_to} cluster"

                            # Update kubeconfig for target cluster
                            aws eks update-kubeconfig --region ${REGION} --name "${PROJECT}-${params.deploy_to}"

                            # Use temporary Helm values file
                            cp frontend-cd/values-${params.deploy_to}.yaml /tmp/values.yaml
                            sed -i "s/IMAGE_VERSION/${params.appVersion}/g" /tmp/values.yaml

                            # Deploy using Helm and wait for pods to be ready
                            helm upgrade --install ${SERVICE_NAME} -f /tmp/values.yaml -n ${PROJECT} frontend-cd/ --wait --timeout 5m
                        """
                    }
                }
            }
        }
    }

    post { 
        always { 
            echo "Cleaning workspace..."
            deleteDir()
        }
        success { 
            echo "✅ Deployment of ${SERVICE_NAME}:${params.appVersion} to ${params.deploy_to} was successful!"
        }
        failure { 
            echo "❌ Deployment failed for ${SERVICE_NAME}:${params.appVersion} in ${params.deploy_to}"
        }
    }
}
